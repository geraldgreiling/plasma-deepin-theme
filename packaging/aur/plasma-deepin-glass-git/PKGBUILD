# Maintainer: Gerald Greiling <gerald.greiling@gmail.com>
# Deepin Glass: window decoration (KDecoration3) and Qt 6 application style for Plasma 6.
pkgname=plasma-deepin-glass-git
_repo=plasma-deepin-theme
pkgver=r1.0000000
pkgrel=1
pkgdesc="Frosted glass window decoration and Qt/Kirigami application style in the Deepin look for KDE Plasma 6 (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/geraldgreiling/plasma-deepin-theme"
license=('GPL-3.0-or-later')
depends=('kdecoration' 'breeze' 'kconfig' 'kcoreaddons' 'kwindowsystem' 'kcolorscheme' 'kiconthemes'
         'kirigami' 'qqc2-desktop-style' 'qt6-base' 'qt6-declarative' 'gcc-libs' 'glibc')
makedepends=('git' 'cmake' 'extra-cmake-modules')
provides=('plasma-deepin-glass')
conflicts=('plasma-deepin-glass')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "${_repo}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cmake -B build -S "${_repo}" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF \
        -Wno-dev
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
}
