# Deepin Glass settings
# Shared by the window decoration, the Qt Widgets application style and the
# Kirigami/Qt Quick integration of plasma-deepin-theme.
#
# By default the whole window - title bar, tool bars, side bars and content -
# is one frosted glass surface with the opacity of the title bar
# ([Decoration] ActiveOpacity / InactiveOpacity). The layer opacities below are
# drawn on top of that surface; 0 keeps everything uniform.
#
# Apply changes:
#   window decoration:  qdbus6 org.kde.KWin /KWin reconfigure
#   applications:       restart the application
# Opacities go from 0 (fully transparent) to 1 (opaque). Blur must be enabled
# in System Settings > Desktop Effects.

[General]
# Version of this file's defaults. Files from older versions are replaced by the
# current defaults once (the old file is kept as deepinglassrc.old).
ConfigVersion=2

[Decoration]
# Height of the title bar in logical pixels
TitleBarHeight=40
# Radius of the window corners
CornerRadius=12
# Opacity of the whole glass surface of active / inactive windows
ActiveOpacity=0.72
InactiveOpacity=0.58
# Ask KWin to blur behind the title bar
Blur=true
# Size and strength of the window shadow (0 disables it)
ShadowSize=36
ShadowStrength=0.38
# Thin outline around windows
Outline=true
# Centre the window title
CenterTitle=true

[Style]
# Qt Widgets applications (Dolphin, Kate, Konsole, ...)
# Frosted glass windows
Translucent=true
# Opacity of the window background: "auto" = same as the title bar
WindowOpacity=auto
# Opacity of popup menus
MenuOpacity=0.82
# Extra layer for side panels (Dolphin places, ...) on top of the window background
SidebarOpacity=0
# Extra layer for content views (file view, lists, text fields) on top of the window background
ViewOpacity=0
# Executable names that stay opaque, comma separated, e.g. ExcludedApplications=krita,kdenlive
ExcludedApplications=

[QtQuick]
# Qt Quick / Kirigami applications (Discover, System Monitor, Elisa, ...)
# Frosted glass windows
Translucent=true
# Opacity of the window background: "auto" = same as the title bar
WindowOpacity=auto
# Extra layers on top of the window background: pages and side bars, content
# views (lists, cards) and tool bars / page headers
PageOpacity=0
ViewOpacity=0
HeaderOpacity=0
# Executable names that stay opaque, comma separated
ExcludedApplications=
