[AdaptiveTransparency]
enabled=true

# Background contrast behind blurred panels and popups (KWin "Background contrast" effect).
# Values are a starting point; Deepin itself tints the blur slightly towards the theme colour.
[ContrastEffect]
enabled=true
contrast=0.35
intensity=1.15
saturation=1.6
